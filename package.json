{
  "name": "gotrade",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "predev": "node scripts/assets.mjs",
    "prebuild": "node scripts/assets.mjs",
    "dev": "next dev --hostname 127.0.0.1 --port 5173",
    "prototipo": "node prototipo/serve.mjs",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 5173",
    "setup": "node scripts/setup.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/design.test.ts tests/branding.test.ts tests/application.test.ts tests/logo-image.test.ts",
    "test:e2e": "playwright test",
    "lint": "oxlint",
    "format": "oxfmt",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "next": "16.3.4",
    "@libsql/client": "^0.17.0",
    "bootstrap-icons": "^1.13.1",
    "@base-ui/react": "1.7.0",
    "@shadcn/react": "0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.2",
    "input-otp": "1.4.2",
    "lucide-react": "1.31.0",
    "react-day-picker": "9.8.1",
    "react-resizable-panels": "4.5.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@playwright/test": "^1.58.2",
    "tsx": "^4.21.0",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
